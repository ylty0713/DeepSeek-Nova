# Copy this file to .deepseek.env and replace the placeholder.
# Do not commit .deepseek.env: it contains a plaintext secret.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Optional overrides for the DeepSeek Nova compatible runtime:
# DEEPSEEK_MODEL=deepseek-v4-pro[1m]
# ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
# CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
# CLAUDE_CODE_EFFORT_LEVEL=max
