{
  "name": "deepseek-nova-desktop",
  "version": "2.1.88",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "description": "Native desktop agent workbench for DeepSeek Nova",
  "author": "DeepSeek Nova",
  "scripts": {
    "start": "electron .",
    "postinstall": "node node_modules/electron/install.js",
    "check": "node --check main.mjs && node --check renderer/app.js && node --check ../runtime-adapter.mjs && node scripts/approval-policy-smoke.mjs && node smoke-test.mjs",
    "build:icons": "python scripts/build-icons.py"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7"
  },
  "build": {
    "appId": "com.wubiaohong.deepseeknova",
    "productName": "DeepSeek Nova",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "approval-policy.mjs",
      "preload.cjs",
      "renderer/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../runtime-adapter.mjs",
        "to": "runtime-adapter.mjs"
      },
      {
        "from": "../RUNTIME_ADAPTER.md",
        "to": "RUNTIME_ADAPTER.md"
      }
    ],
    "win": {
      "icon": "build/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Nova",
      "installerIcon": "build/app-icon.ico",
      "uninstallerIcon": "build/app-icon.ico",
      "artifactName": "DeepSeek-Nova-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DeepSeek-Nova-Portable-${version}-${arch}.${ext}"
    }
  }
}
